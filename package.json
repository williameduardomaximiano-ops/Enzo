{
  "name": "enzo-assistente",
  "version": "0.1.5",
  "description": "COSMO — assistente pessoal local para Windows",
  "main": "desktop/main.cjs",
  "author": "Ágape Studio",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "npm run bundle && electron .",
    "bundle": "esbuild ui/app.js --bundle --format=iife --outfile=ui/bundle.js",
    "test": "node --test tests/*.test.cjs",
    "build:win": "npm run bundle && electron-builder --win dir --x64 --publish never && node scripts/uninstall-list.cjs && electron-builder --win nsis --x64 --prepackaged dist/win-unpacked --publish never"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "studio.agape.enzo",
    "productName": "COSMO",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "core/**",
      "ui/**",
      "android/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "runtime"
      },
      {
        "from": "voice",
        "to": "voice"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "artifactName": "ENZO-${version}-Windows-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "script": "scripts/installer.nsi",
      "installerLanguages": [
        "pt_BR"
      ]
    }
  }
}
